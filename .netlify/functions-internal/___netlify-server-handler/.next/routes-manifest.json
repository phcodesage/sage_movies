    },
    {
      "page": "/api/check-servers",
      "regex": "^/api/check\\-servers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/check\\-servers(?:/)?$"
    },
    {
      "page": "/api/genres",
      "regex": "^/api/genres(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/genres(?:/)?$"
    },
    {
      "page": "/api/movies/collection",
      "regex": "^/api/movies/collection(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/movies/collection(?:/)?$"
    },
    {
      "page": "/api/search",
      "regex": "^/api/search(?:/)?$",
