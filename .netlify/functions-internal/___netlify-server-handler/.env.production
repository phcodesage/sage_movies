# Production environment variables
# Note: This file should be included in .gitignore in a real production environment
# and the actual values should be set in the deployment environment
PORT=3000
NODE_ENV=production

TMDB_IMG_URL=https://image.tmdb.org/t/p/original
# TMDB_API_KEY=your_api_key_here

# Adsterra units are live; serve them in production builds.
NEXT_PUBLIC_ADSTERRA_ENABLED=true

# Direct Link opened after every 3rd playback interaction. Paste the Direct Link URL
# from the Adsterra dashboard here to activate it; empty keeps the feature inert.
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK=
NEXT_PUBLIC_MAINTENANCE_MODE=false
